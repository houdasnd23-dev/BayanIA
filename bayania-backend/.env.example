
# Configuration de l'API FastAPI
PROJECT_NAME="BayanIA"
ENV="development"
DEBUG=true
# Configuration de la base de données PostgreSQL (SQLAlchemy Async)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/bayania"
# Configuration JWT & Sécurité
JWT_SECRET="super-secret-jwt-key-change-me-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Configuration de la base de données vectorielle Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
# Configuration du LLM (Gemini)
LLM_PROVIDER="gemini"
# Clé utilisée pour les embeddings (gemini-embedding-001)
GEMINI_API_KEY=""
# Clé utilisée pour la génération de réponses (gemini-3.6-flash, avec fallback 3.5/3.0)
GEMINI_GENERATION_API_KEY=""
# Paramètres RAG
RAG_TOP_K=4
RAG_MIN_SCORE=0.5
# Configuration de stockage local (Pièces jointes)
UPLOAD_DIR="./uploads"
