{
  "expo": {
    "name": "bayania-mobile",
    "slug": "bayania-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    
    "scheme": "bayaniamobile",
    "userInterfaceStyle": "automatic",
    
    "android": {
      "adaptiveIcon": {
      
      },
      "predictiveBackGestureEnabled": false
    },
   
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
